{
  "rules": {
    "usernames": {
      "$username": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.val() == auth.uid"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "gamePresence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "trades": {
      ".read": "auth != null",
      "$trade": {
        ".write": "auth != null && ((!data.exists() && newData.child('fromUid').val() == auth.uid) || data.child('fromUid').val() == auth.uid || data.child('toUid').val() == auth.uid)"
      }
    },
    "worlds": {
      "$world": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
