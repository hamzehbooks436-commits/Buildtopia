{
  "rules": {
    "usernames": {
      "$username": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.val() == auth.uid"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "gamePresence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "trades": {
      ".read": "auth != null",
      "$trade": {
        ".write": "auth != null && ((!data.exists() && newData.child('fromUid').val() == auth.uid) || data.child('fromUid').val() == auth.uid || data.child('toUid').val() == auth.uid)"
      }
    },
    "worlds": {
      "$world": {
        ".read": "auth != null",
        "state": { ".write": "auth != null" },
        "meta": { ".write": "auth != null" },
        "presence": {
          "$uid": { ".write": "auth != null && auth.uid == $uid" }
        },
        "npcs": {
          ".write": "auth != null && auth.uid == 'qSv2Mg9XCEQmr1ymQe6BQ4cZi9Z2'",
          "$npc": {
            ".validate": "newData.hasChildren(['name', 'x', 'y', 'enabled'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40" },
            "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 128 && newData.val() % 1 == 0" },
            "y": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 72 && newData.val() % 1 == 0" },
            "enabled": { ".validate": "newData.isBoolean()" }
          }
        }
      }
    }
  }
}
